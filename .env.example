# Copy to .env for local testing, or set as build args / repo secrets in CI.
# All of these are optional — the site builds and runs fine without them,
# just without comments/analytics.

# giscus comments — requires a public repo with Discussions enabled and the
# giscus app installed (https://github.com/apps/giscus). Get these values from
# https://giscus.app once the repo exists.
GISCUS_REPO=rashm1n/blog-v2
GISCUS_REPO_ID=
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=

# Self-hosted Umami analytics (see docker-compose.yml in Phase 5).
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=/stats.js
