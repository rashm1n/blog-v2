---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <Header />
    <main class="mx-auto max-w-2xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
    <Search />
  </body>
</html>
