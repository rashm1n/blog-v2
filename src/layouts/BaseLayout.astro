---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Shortcuts from '../components/Shortcuts.astro';
import type { JsonLdNode } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  jsonLd?: JsonLdNode[];
  markdownPath?: string;
  published?: Date;
  updated?: Date;
  tags?: string[];
  /** Let the page use the full frame instead of the reading column. */
  wide?: boolean;
}

const { title, description, image, article, jsonLd, markdownPath, published, updated, tags, wide } =
  Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      jsonLd={jsonLd}
      markdownPath={markdownPath}
      published={published}
      updated={updated}
      tags={tags}
    />
  </head>
  <body class="flex min-h-screen flex-col text-foreground antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-border focus:bg-background focus:px-3 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <Header />

    <!-- tabindex="-1" so the skip link and back-to-top can move focus here;
         it stays out of the tab order. -->
    <main id="content" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 sm:px-6 focus:outline-none">
      <div class:list={[!wide && 'max-w-[51rem]']}>
        <slot />
      </div>
    </main>

    <Footer />
    <Search />
    <Shortcuts />
  </body>
</html>
