---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { formatDate, readingTime, sectionFor, wordCount } from '../utils/posts';
import { markdownPath } from '../utils/markdown';
import { articleNodes } from '../utils/schema';
import { SITE_URL } from '../consts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  headings: Heading[];
  body: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = entry.data;
const minutes = readingTime(body);
const ogImage = `/og/${entry.id}.png`;

// Built here rather than in BaseHead so the article nodes see the entry. The
// canonical expression matches BaseHead's exactly — the schema's `url` and the
// <link rel="canonical"> must agree or Google discards the markup.
const siteURL = Astro.site ?? new URL(SITE_URL);
const jsonLd = articleNodes({
  site: siteURL,
  entry,
  canonical: new URL(Astro.url.pathname, siteURL),
  image: new URL(ogImage, siteURL),
  section: sectionFor(entry.collection),
  wordCount: wordCount(body),
  minutes,
});
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article
  jsonLd={jsonLd}
  markdownPath={markdownPath(entry)}
>
  <ReadingProgress />

  <article class="pt-10 pb-8 sm:pt-14">
    <header class="reveal">
      <div class="label flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="text-border" aria-hidden="true">/</span>
        <span>{minutes} min read</span>
        {
          updatedDate && (
            <>
              <span class="text-border" aria-hidden="true">
                /
              </span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )
        }
      </div>

      <h1 class="mt-4 text-[1.75rem] font-semibold leading-[1.15] tracking-tight text-fg sm:text-4xl">
        {title}
      </h1>

      <p class="mt-4 text-base leading-relaxed text-muted">{description}</p>

      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-md border border-border px-2 py-0.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="mt-8 h-px bg-border"></div>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={1600}
          height={900}
          class="mt-8 aspect-[16/9] w-full rounded-xl border border-border object-cover"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose mt-8" data-pagefind-body>
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="mt-16 grid grid-cols-1 gap-3 border-t border-border pt-8 sm:grid-cols-2">
          {prev ? (
            <a
              href={prev.href}
              class="group rounded-lg border border-border p-4 transition-colors hover:border-muted hover:bg-surface"
            >
              <span class="label">← Previous</span>
              <span class="mt-1.5 block text-sm text-fg transition-colors group-hover:text-accent">
                {prev.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}
          {next && (
            <a
              href={next.href}
              class="group rounded-lg border border-border p-4 transition-colors hover:border-muted hover:bg-surface sm:text-right"
            >
              <span class="label">Next →</span>
              <span class="mt-1.5 block text-sm text-fg transition-colors group-hover:text-accent">
                {next.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    <section class="mt-16 pt-4">
      <h2 class="rule-heading label">Comments</h2>
      <div class="mt-5">
        <Comments />
      </div>
    </section>
  </article>

  <CodeBlocks />

  <script>
    // Give every prose heading a clickable anchor. Cheaper than pulling in
    // rehype-autolink-headings just to emit one <a> per heading.
    for (const heading of document.querySelectorAll<HTMLElement>(
      '.prose h2[id], .prose h3[id], .prose h4[id]'
    )) {
      heading.style.position = 'relative';
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', `Link to section: ${heading.textContent}`);
      heading.prepend(anchor);
    }
  </script>
</BaseLayout>
