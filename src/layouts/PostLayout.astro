---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import PostImages from '../components/PostImages.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostActions from '../components/PostActions.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Separator } from '@/components/ui/separator';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import {
  formatDate,
  getPublished,
  readingTime,
  relatedTo,
  sectionFor,
  titleTransitionName,
  wordCount,
} from '../utils/posts';
import { markdownPath } from '../utils/markdown';
import { articleNodes } from '../utils/schema';
import { SITE_URL } from '../consts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  headings: Heading[];
  body: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = entry.data;
const minutes = readingTime(body);
const ogImage = `/og/${entry.id}.png`;

// Computed here rather than in each route's getStaticPaths so `/blog` and
// `/travel` can't drift apart on how "related" is defined. The prev/next pair
// is excluded because it is already rendered a few rows further down — on a
// small corpus every "related" post would otherwise be one of those two.
const [allPosts, allTravel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const adjacent = new Set([prev?.href, next?.href].filter(Boolean));
const related = relatedTo(
  entry,
  [...allPosts, ...allTravel].filter(
    (candidate) => !adjacent.has(`${sectionFor(candidate.collection).path}/${candidate.id}`)
  )
);

// Built here rather than in BaseHead so the article nodes see the entry. The
// canonical expression matches BaseHead's exactly — the schema's `url` and the
// <link rel="canonical"> must agree or Google discards the markup.
const siteURL = Astro.site ?? new URL(SITE_URL);
const jsonLd = articleNodes({
  site: siteURL,
  entry,
  canonical: new URL(Astro.url.pathname, siteURL),
  image: new URL(ogImage, siteURL),
  section: sectionFor(entry.collection),
  wordCount: wordCount(body),
  minutes,
});
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article
  published={pubDate}
  updated={updatedDate}
  tags={tags}
  jsonLd={jsonLd}
  markdownPath={markdownPath(entry)}
>
  <ReadingProgress />

  <article class="pt-10 pb-8 sm:pt-14">
    <header class="reveal">
      <div class="label flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="text-border" aria-hidden="true">/</span>
        <span>{minutes} min read</span>
        {
          updatedDate && (
            <>
              <span class="text-border" aria-hidden="true">
                /
              </span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )
        }
      </div>

      <h1
        class="text-gradient mt-4 text-[1.875rem] leading-[1.12] font-semibold tracking-tighter sm:text-[2.5rem]"
        style={`view-transition-name: ${titleTransitionName(entry.id)}; view-transition-class: post-title`}
      >
        {title}
      </h1>

      <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">{description}</p>

      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <a
                href={`/tags/${tag}`}
                class={cn(
                  badgeVariants({ variant: 'outline' }),
                  'h-6 px-2 font-mono text-xs font-normal text-muted-foreground transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary'
                )}
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <Separator className="mt-8" />

    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={1600}
          height={900}
          class="mt-8 aspect-[16/9] w-full rounded-xl border border-border object-cover"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose mt-8" data-pagefind-body>
      <slot />
    </div>

    <PostActions title={title} path={Astro.url.pathname} />

    <RelatedPosts entries={related} />

    {
      (prev || next) && (
        <nav data-noprint class="mt-16 border-t border-border pt-8">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {prev ? (
              <a href={prev.href} class="group block">
                <Card className="card-interactive h-full gap-1.5 border bg-card/70 py-4 ring-0">
                  <CardContent>
                    <span class="label">← Previous</span>
                    <span class="mt-1.5 block text-sm leading-snug text-foreground transition-colors group-hover:text-primary">
                      {prev.title}
                    </span>
                  </CardContent>
                </Card>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}
            {next && (
              <a href={next.href} class="group block sm:text-right">
                <Card className="card-interactive h-full gap-1.5 border bg-card/70 py-4 ring-0">
                  <CardContent>
                    <span class="label">Next →</span>
                    <span class="mt-1.5 block text-sm leading-snug text-foreground transition-colors group-hover:text-primary">
                      {next.title}
                    </span>
                  </CardContent>
                </Card>
              </a>
            )}
          </div>
        </nav>
      )
    }

    <section data-noprint class="mt-16 pt-4">
      <h2 class="rule-heading label">Comments</h2>
      <div class="mt-5">
        <Comments />
      </div>
    </section>
  </article>

  <CodeBlocks />
  <PostImages />

  <script>
    // Give every prose heading a clickable anchor. Cheaper than pulling in
    // rehype-autolink-headings just to emit one <a> per heading.
    for (const heading of document.querySelectorAll<HTMLElement>(
      '.prose h2[id], .prose h3[id], .prose h4[id]'
    )) {
      heading.style.position = 'relative';
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', `Link to section: ${heading.textContent}`);
      heading.prepend(anchor);
    }
  </script>
</BaseLayout>
