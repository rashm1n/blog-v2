---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import PostImages from '../components/PostImages.astro';
import { Separator } from '@/components/ui/separator';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostActions from '../components/PostActions.astro';
import {
  formatDate,
  getPublished,
  readingTime,
  relatedTo,
  sectionFor,
  titleTransitionName,
  wordCount,
} from '../utils/posts';
import { markdownPath } from '../utils/markdown';
import { articleNodes } from '../utils/schema';
import { SITE_URL } from '../consts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  headings: Heading[];
  body: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = entry.data;
const minutes = readingTime(body);
const words = wordCount(body);
const section = sectionFor(entry.collection);
const sourcePath = markdownPath(entry);
const ogImage = `/og/${entry.id}.jpg`;

// Computed here rather than in each route's getStaticPaths so `/blog` and
// `/travel` can't drift apart on how "related" is defined. The prev/next pair
// is excluded because it is already rendered a few rows further down — on a
// small corpus every "related" post would otherwise be one of those two.
const [allPosts, allTravel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const adjacent = new Set([prev?.href, next?.href].filter(Boolean));
const related = relatedTo(
  entry,
  [...allPosts, ...allTravel].filter(
    (candidate) => !adjacent.has(`${sectionFor(candidate.collection).path}/${candidate.id}`)
  )
);

// Built here rather than in BaseHead so the article nodes see the entry. The
// canonical expression matches BaseHead's exactly — the schema's `url` and the
// <link rel="canonical"> must agree or Google discards the markup.
const siteURL = Astro.site ?? new URL(SITE_URL);
const jsonLd = articleNodes({
  site: siteURL,
  entry,
  canonical: new URL(Astro.url.pathname, siteURL),
  image: new URL(ogImage, siteURL),
  section: sectionFor(entry.collection),
  wordCount: words,
  minutes,
});
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article
  published={pubDate}
  updated={updatedDate}
  tags={tags}
  jsonLd={jsonLd}
  markdownPath={sourcePath}
>

  <article class="pt-10 pb-8 sm:pt-16">
    <header>
      <nav aria-label="Breadcrumb" data-noprint class="label mb-6 flex gap-2">
        <a href={section.path} class="hover:text-primary">{section.label}</a>
        <span aria-hidden="true">/</span>
        <span class="truncate" aria-current="page">{entry.id}</span>
      </nav>

      <h1
        class="max-w-[20ch] text-[2.5rem] leading-[1.1] sm:text-[3.75rem]"
        style={`view-transition-name: ${titleTransitionName(entry.id)}; view-transition-class: post-title`}
      >
        {title}
      </h1>

      <p class="mt-5 text-xl leading-relaxed text-muted-foreground">{description}</p>

      {/* Facts about the post, labelled, in one scannable row. */}
      <Separator className="mt-8" />
      <dl class="grid grid-cols-2 gap-x-6 gap-y-3 py-4 xs:grid-cols-4">
        <div>
          <dt class="label">Published</dt>
          <dd class="label text-foreground"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
        </div>
        {updatedDate && (
          <div>
            <dt class="label">Updated</dt>
            <dd class="label text-foreground"><time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></dd>
          </div>
        )}
        <div>
          <dt class="label">Length</dt>
          <dd class="label tabular-nums text-foreground">{minutes} min, {words.toLocaleString('en-US')} words</dd>
        </div>
        <div data-noprint>
          <dt class="label">Source</dt>
          <dd class="label">
            <a href={sourcePath} class="text-primary underline decoration-transparent underline-offset-4 hover:decoration-current">
              View as Markdown
            </a>
          </dd>
        </div>
      </dl>
      <Separator />

      {
        tags.length > 0 && (
          <p class="label mt-4 flex flex-wrap gap-x-3">
            <span>Tagged</span>
            {tags.map((tag: string) => (
              <a href={`/tags/${tag}`} class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-current">{tag}</a>
            ))}
          </p>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={1600}
          height={900}
          loading="eager"
          class="mt-10 aspect-[16/9] w-full rounded-md border border-border object-cover"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose mt-8" data-pagefind-body>
      <slot />
    </div>

    <PostActions title={title} path={Astro.url.pathname} />

    <RelatedPosts entries={related} />

    {
      (prev || next) && (
        <nav data-noprint aria-label="More posts" class="mt-14 grid grid-cols-1 border-t border-border sm:grid-cols-2">
          {prev ? (
            <a href={prev.href} rel="prev" class="group block py-6 sm:pr-6">
              <span class="label block">Previous</span>
              <span class="display mt-1 block text-xl leading-tight transition-colors group-hover:text-primary">{prev.title}</span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}
          {next && (
            <a href={next.href} rel="next" class="group block border-t border-border py-6 sm:border-t-0 sm:border-l sm:pl-6 sm:text-right">
              <span class="label block">Next</span>
              <span class="display mt-1 block text-xl leading-tight transition-colors group-hover:text-primary">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <Comments />
  </article>

  <CodeBlocks />
  <PostImages />

  <script>
    // Give every prose heading a clickable anchor. Cheaper than pulling in
    // rehype-autolink-headings just to emit one <a> per heading.
    for (const heading of document.querySelectorAll<HTMLElement>(
      '.prose h2[id], .prose h3[id], .prose h4[id]'
    )) {
      heading.style.position = 'relative';
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', `Link to section: ${heading.textContent}`);
      heading.prepend(anchor);
    }
  </script>
</BaseLayout>
