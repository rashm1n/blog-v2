---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import { formatDate, readingTime } from '../utils/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  headings: Heading[];
  body: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = entry.data;
const minutes = readingTime(body);
const ogImage = `/og/${entry.id}.png`;
---

<BaseLayout title={title} description={description} image={ogImage} article>
  <article class="py-8">
    {heroImage && (
      <Image
        src={heroImage}
        alt=""
        width={1600}
        height={900}
        class="mb-10 aspect-[16/9] w-full rounded-xl object-cover"
      />
    )}
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
        {updatedDate && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>Updated {formatDate(updatedDate)}</span>
          </>
        )}
      </div>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted transition-colors hover:text-fg"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <TableOfContents headings={headings} />

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    {(prev || next) && (
      <nav class="mt-16 grid grid-cols-1 gap-4 border-t border-border pt-8 text-sm sm:grid-cols-2">
        <div>
          {prev && (
            <a href={prev.href} class="group block">
              <span class="text-muted">&larr; Previous</span>
              <span class="mt-1 block text-fg group-hover:text-accent">{prev.title}</span>
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {next && (
            <a href={next.href} class="group block">
              <span class="text-muted">Next &rarr;</span>
              <span class="mt-1 block text-fg group-hover:text-accent">{next.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <div class="mt-16 border-t border-border pt-8">
      <Comments />
    </div>
  </article>
</BaseLayout>
