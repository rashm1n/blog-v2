---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import PostImages from '../components/PostImages.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostActions from '../components/PostActions.astro';
import PostRing from '../components/PostRing.astro';
import {
  formatDate,
  getPublished,
  readingTime,
  relatedTo,
  sectionFor,
  titleTransitionName,
  wordCount,
} from '../utils/posts';
import { markdownPath } from '../utils/markdown';
import { articleNodes } from '../utils/schema';
import { SITE_URL } from '../consts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  headings: Heading[];
  body: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, body, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = entry.data;
const minutes = readingTime(body);
const ogImage = `/og/${entry.id}.png`;

// Computed here rather than in each route's getStaticPaths so `/blog` and
// `/travel` can't drift apart on how "related" is defined. The prev/next pair
// is excluded because it is already rendered a few rows further down — on a
// small corpus every "related" post would otherwise be one of those two.
const [allPosts, allTravel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const adjacent = new Set([prev?.href, next?.href].filter(Boolean));
const related = relatedTo(
  entry,
  [...allPosts, ...allTravel].filter(
    (candidate) => !adjacent.has(`${sectionFor(candidate.collection).path}/${candidate.id}`)
  )
);

// Built here rather than in BaseHead so the article nodes see the entry. The
// canonical expression matches BaseHead's exactly — the schema's `url` and the
// <link rel="canonical"> must agree or Google discards the markup.
const siteURL = Astro.site ?? new URL(SITE_URL);
const jsonLd = articleNodes({
  site: siteURL,
  entry,
  canonical: new URL(Astro.url.pathname, siteURL),
  image: new URL(ogImage, siteURL),
  section: sectionFor(entry.collection),
  wordCount: wordCount(body),
  minutes,
});
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article
  published={pubDate}
  updated={updatedDate}
  tags={tags}
  jsonLd={jsonLd}
  markdownPath={markdownPath(entry)}
>
  <ReadingProgress />

  <article class="pt-12 pb-8 sm:pt-20">
    <header class="relative">
      {/* Ring and meta sit above the title on narrow screens; hung in the
          left margin, level with the title, once there is a margin to hang them in. */}
      <div class="flex items-center gap-4 xl:absolute xl:top-1 xl:right-full xl:mr-10 xl:w-36 xl:flex-col xl:items-end xl:gap-5">
        <PostRing id={entry.id} tags={tags} class="size-11 shrink-0 xl:size-24" />
        <div class="label flex flex-wrap gap-x-4 gap-y-0.5 xl:flex-col xl:text-right">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span>{minutes} min read</span>
          {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
        </div>
      </div>

      <h1
        class="mt-5 text-[2.25rem] leading-[1.1] font-medium tracking-[-0.015em] sm:text-5xl xl:mt-0"
        style={`view-transition-name: ${titleTransitionName(entry.id)}; view-transition-class: post-title`}
      >
        {title}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{description}</p>

      {
        tags.length > 0 && (
          <p class="label mt-4 flex flex-wrap gap-x-3">
            {tags.map((tag: string) => (
              <a href={`/tags/${tag}`} class="underline decoration-border underline-offset-4 hover:text-foreground hover:decoration-current">
                {tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={1600}
          height={900}
          class="mt-10 aspect-[16/9] w-full rounded-lg border border-border object-cover"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose mt-8" data-pagefind-body>
      <slot />
    </div>

    <PostActions title={title} path={Astro.url.pathname} />

    <RelatedPosts entries={related} />

    {
      (prev || next) && (
        <nav data-noprint aria-label="More posts" class="mt-16 grid grid-cols-1 gap-8 border-t border-border pt-8 sm:grid-cols-2">
          {prev ? (
            <a href={prev.href} class="group block">
              <span class="label block">Previous</span>
              <span class="mt-1 block font-serif text-lg leading-snug transition-colors group-hover:text-primary">
                {prev.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}
          {next && (
            <a href={next.href} class="group block sm:text-right">
              <span class="label block">Next</span>
              <span class="mt-1 block font-serif text-lg leading-snug transition-colors group-hover:text-primary">
                {next.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    <section data-noprint class="mt-16 pt-4">
      <h2 class="rule-heading label">Comments</h2>
      <div class="mt-5">
        <Comments />
      </div>
    </section>
  </article>

  <CodeBlocks />
  <PostImages />

  <script>
    // Give every prose heading a clickable anchor. Cheaper than pulling in
    // rehype-autolink-headings just to emit one <a> per heading.
    for (const heading of document.querySelectorAll<HTMLElement>(
      '.prose h2[id], .prose h3[id], .prose h4[id]'
    )) {
      heading.style.position = 'relative';
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', `Link to section: ${heading.textContent}`);
      heading.prepend(anchor);
    }
  </script>
</BaseLayout>
