---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <div class="pt-14 pb-24 sm:pt-24">
    <h1 class="text-4xl leading-[1.05] font-medium tracking-[-0.03em] sm:text-[3.25rem]">
      There’s nothing at <span id="missing-path" class="break-all">this address</span>.
    </h1>
    <p class="mt-6 text-muted-foreground">
      It may have moved, or never existed. Try the <a href="/blog" class="text-primary underline underline-offset-4">list of posts</a>,
      search with <kbd class="kbd" data-shortcut-hint>⌘K</kbd>, or go to the <a href="/" class="text-primary underline underline-offset-4">home page</a>.
    </p>
  </div>

  <script>
    // This page is served for any unmatched URL, so the real path is only known
    // at runtime — Astro.url.pathname would always render "/404" here.
    // Assigned as textContent, never innerHTML: the path is attacker-controlled.
    const slot = document.getElementById('missing-path');
    if (slot) slot.textContent = location.pathname;
  </script>
</BaseLayout>
