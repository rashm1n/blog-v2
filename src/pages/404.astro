---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Card } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<BaseLayout title="Not found" description="Page not found.">
  <div class="flex flex-col items-start gap-6 py-24">
    <Card className="reveal w-full gap-0 border bg-card/70 py-0 font-mono text-sm ring-0 backdrop-blur-sm">
      <div class="flex items-center gap-1.5 border-b border-border px-3 py-2.5">
        <span class="size-2.5 rounded-full bg-destructive/70"></span>
        <span class="size-2.5 rounded-full bg-[oklch(0.78_0.16_85)]/70"></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70"></span>
      </div>
      <div class="space-y-1 px-4 py-4">
        <p class="text-muted-foreground">
          <span class="text-primary">$</span> curl -sI <span id="missing-path">/…</span>
        </p>
        <p class="text-foreground">HTTP/2 404</p>
      </div>
    </Card>

    <h1
      class="reveal text-gradient text-3xl font-semibold tracking-tighter"
      style="--reveal-delay: 60ms"
    >
      Page not found
    </h1>
    <p class="reveal -mt-2 text-sm text-muted-foreground" style="--reveal-delay: 100ms">
      That URL doesn't resolve to anything. It may have moved, or never existed.
    </p>

    <div class="reveal flex flex-wrap gap-2" style="--reveal-delay: 140ms">
      <a href="/" class={cn(buttonVariants({ size: 'lg' }), 'h-10 px-4')}>Home</a>
      <a
        href="/blog"
        class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-10 px-3.5')}
      >
        All writing
      </a>
    </div>
  </div>

  <script>
    // This page is served for any unmatched URL, so the real path is only known
    // at runtime — Astro.url.pathname would always render "/404" here.
    // Assigned as textContent, never innerHTML: the path is attacker-controlled.
    const slot = document.getElementById('missing-path');
    if (slot) slot.textContent = location.pathname;
  </script>
</BaseLayout>
