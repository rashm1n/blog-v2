---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../utils/posts';

const posts = await getPublished('posts');
const description =
  'Technical writing on ai, microservices, distributed systems, and software engineering.';
---

<BaseLayout title="Writing" description={description}>
  <PageHeader
    eyebrow={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
    title="Writing"
    description={description}
  />

  <div class="space-y-3 pb-8">
    {posts.map((post, i) => <PostCard entry={post} basePath="/blog" index={i} />)}
    {posts.length === 0 && <p class="py-8 text-sm text-muted-foreground">Nothing published yet.</p>}
  </div>
</BaseLayout>
