---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostIndex from '../../components/PostIndex.astro';
import TopicFilter from '../../components/TopicFilter.astro';
import { getPublished } from '../../utils/posts';

const posts = await getPublished('posts');
const description =
  'Technical writing on AI, microservices, distributed systems and software engineering.';
---

<BaseLayout title="Writing" description={description}>
  <PageHeader
    eyebrow={posts.length > 0 ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}` : undefined}
    title="Writing"
    description={description}
  />

  <div class="pb-8">
    <TopicFilter entries={posts} />
    <PostIndex entries={posts} />
    {posts.length === 0 && <p class="py-8 text-muted-foreground">Nothing published yet.</p>}
  </div>
</BaseLayout>
