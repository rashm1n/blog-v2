---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPublished } from '../../utils/posts';

const posts = await getPublished('posts');
---

<BaseLayout title="Writing" description="Technical writing on distributed systems, infrastructure, and software engineering.">
  <div class="py-8">
    <h1 class="text-2xl font-semibold tracking-tight text-fg">Writing</h1>
    <div class="mt-6 divide-y divide-border">
      {posts.map((post) => <PostListItem entry={post} basePath="/blog" />)}
      {posts.length === 0 && <p class="py-8 text-sm text-muted">Nothing published yet.</p>}
    </div>
  </div>
</BaseLayout>
