---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Photos" description="Photo gallery — coming soon.">
  <PageHeader eyebrow="Coming soon" title="Photos" description="A gallery is on the way." />

  <div class="grid grid-cols-2 gap-3 pb-8 sm:grid-cols-3">
    {
      Array.from({ length: 6 }).map(() => (
        <div class="aspect-square rounded-lg border border-dashed border-border bg-surface/40" />
      ))
    }
  </div>

  <a
    href="/"
    class="group inline-flex items-center gap-1.5 pb-8 font-mono text-xs text-muted transition-colors hover:text-fg"
  >
    <span class="text-accent transition-transform group-hover:-translate-x-0.5">←</span>
    Back home
  </a>
</BaseLayout>
