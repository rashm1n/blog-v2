---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndex from '../components/PostIndex.astro';
import TopicFilter from '../components/TopicFilter.astro';
import { SITE_LEAD } from '../consts';
import { getPublished } from '../utils/posts';

const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const entries = [...posts, ...travel].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Feeds are first-class here (see PRODUCT.md), so they're offered up front
// rather than buried in the footer.
const feeds = [
  { label: 'RSS', href: '/rss.xml', note: 'full posts' },
  { label: 'JSON Feed', href: '/feed.json', note: 'full posts' },
  { label: 'llms.txt', href: '/llms.txt', note: 'for agents' },
];
---

<BaseLayout wide>
  <div class="grid gap-10 pt-14 pb-14 sm:pt-20 lg:grid-cols-[1fr_15rem] lg:gap-16">
    {/* The one loud thing on the page. */}
    <h1 class="reveal max-w-[30ch] text-[1.75rem] leading-[1.05] sm:text-[2.875rem]">
      {SITE_LEAD}
    </h1>

    <aside class="self-end border-l border-border pl-5" aria-labelledby="subscribe-heading">
      <h2 id="subscribe-heading" class="label text-foreground">Subscribe</h2>
      <ul class="mt-2 space-y-1">
        {
          feeds.map((feed) => (
            <li class="flex items-baseline justify-between gap-4">
              <a href={feed.href} class="label text-[0.8125rem] text-primary underline decoration-transparent underline-offset-4 hover:decoration-current">
                {feed.label}
              </a>
              <span class="label">{feed.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="label mt-4 hidden [@media(hover:hover)]:block">
        Press <kbd class="kbd">?</kbd> for keyboard shortcuts
      </p>
    </aside>
  </div>

  <section aria-labelledby="log-heading">
    <h2 id="log-heading" class="sr-only">All posts</h2>
    <TopicFilter entries={entries} />
    <PostIndex entries={entries} />
    {entries.length === 0 && <p class="py-8 text-muted-foreground">Nothing published yet.</p>}
  </section>
</BaseLayout>
