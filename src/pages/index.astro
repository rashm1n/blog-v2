---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, SITE_LEAD, SOCIAL_LINKS } from '../consts';
import { allTags, getPublished } from '../utils/posts';

const allPosts = await getPublished('posts');
const allTravel = await getPublished('travel');
const posts = allPosts.slice(0, 5);
const travel = allTravel.slice(0, 3);

// Most-used tags first, so the row reads as "what this site is about" rather
// than as an alphabetical index — /tags already does the exhaustive version.
const entries = [...allPosts, ...allTravel];
const topics = allTags(entries)
  .map((tag) => ({ tag, count: entries.filter((e) => e.data.tags.includes(tag)).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 8);
---

<BaseLayout>
  <section class="reveal pt-10 pb-14 sm:pt-16">
    <p class="label flex items-center gap-2">
      <span class="relative flex h-1.5 w-1.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-accent opacity-60"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
      </span>
      {AUTHOR_ROLE}
    </p>

    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
      {AUTHOR_NAME}
    </h1>

    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
      {SITE_LEAD}
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            rel="me"
            class="group inline-flex items-center gap-1.5 text-muted transition-colors hover:text-fg"
          >
            <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
            {link.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="py-6">
    <h2 class="rule-heading label">Writing</h2>
    <div class="mt-3">
      {posts.map((post) => <PostListItem entry={post} basePath="/blog" />)}
      {posts.length === 0 && <p class="py-8 text-sm text-muted">Nothing published yet.</p>}
    </div>
    {
      posts.length > 0 && (
        <a
          href="/blog"
          class="group mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-fg"
        >
          All writing
          <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      )
    }
  </section>

  {
    travel.length > 0 && (
      <section class="py-6">
        <h2 class="rule-heading label">Travel</h2>
        <div class="mt-3">
          {travel.map((post) => (
            <PostListItem entry={post} basePath="/travel" />
          ))}
        </div>
        <a
          href="/travel"
          class="group mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-fg"
        >
          All travel
          <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </section>
    )
  }

  {
    topics.length > 0 && (
      <section class="py-6 pb-16">
        <h2 class="rule-heading label">Topics</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {topics.map(({ tag, count }) => (
            <a
              href={`/tags/${tag}`}
              class="group inline-flex items-center gap-2 rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
            >
              #{tag}
              <span class="tabular-nums text-muted/60 transition-colors group-hover:text-accent/70">
                {count}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
