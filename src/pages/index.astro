---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndex from '../components/PostIndex.astro';
import { SITE_LEAD } from '../consts';
import { allTags, getPublished } from '../utils/posts';

const allPosts = await getPublished('posts');
const allTravel = await getPublished('travel');
const posts = allPosts.slice(0, 8);
const travel = allTravel.slice(0, 3);

// Most-used tags first, so the row reads as "what this site is about" rather
// than as an alphabetical index — /tags already does the exhaustive version.
const entries = [...allPosts, ...allTravel];
const topics = allTags(entries)
  .map((tag) => ({ tag, count: entries.filter((e) => e.data.tags.includes(tag)).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 8);
---

<BaseLayout>
  {/* The one loud thing on the site: a single typeset sentence. Everything
      after it is set quietly. */}
  <h1
    class="reveal pt-14 pb-16 text-[2.125rem] leading-[1.12] font-normal tracking-[-0.015em] sm:pt-24 sm:pb-20 sm:text-[2.875rem]"
  >
    {SITE_LEAD}
  </h1>

  <section aria-labelledby="writing-heading">
    <h2 id="writing-heading" class="sr-only">Writing</h2>
    <PostIndex entries={posts} />
    {posts.length === 0 && <p class="py-8 text-muted-foreground">Nothing published yet.</p>}
    {
      allPosts.length > posts.length && (
        <a href="/blog" class="label mt-6 inline-block underline underline-offset-4 hover:text-foreground">
          All {allPosts.length} posts
        </a>
      )
    }
  </section>

  {
    travel.length > 0 && (
      <section class="mt-20">
        <h2 class="mb-4 text-2xl font-medium">Travel</h2>
        <PostIndex entries={travel} />
      </section>
    )
  }

  {
    topics.length > 0 && (
      <section class="mt-20 pb-8">
        <h2 class="label">Topics</h2>
        <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {topics.map(({ tag }) => (
            <a href={`/tags/${tag}`} class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-current">
              {tag}
            </a>
          ))}
        </p>
      </section>
    )
  }
</BaseLayout>
