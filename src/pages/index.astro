---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { AuthorAvatar } from '../components/AuthorAvatar';
import { Badge, badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { AUTHOR_NAME, AUTHOR_ROLE, SITE_LEAD, SOCIAL_LINKS } from '../consts';
import { allTags, getPublished } from '../utils/posts';

const allPosts = await getPublished('posts');
const allTravel = await getPublished('travel');
const posts = allPosts.slice(0, 5);
const travel = allTravel.slice(0, 3);

// Most-used tags first, so the row reads as "what this site is about" rather
// than as an alphabetical index — /tags already does the exhaustive version.
const entries = [...allPosts, ...allTravel];
const topics = allTags(entries)
  .map((tag) => ({ tag, count: entries.filter((e) => e.data.tags.includes(tag)).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, 8);

const initial = AUTHOR_NAME.slice(0, 1).toUpperCase();
---

<BaseLayout>
  <section class="pt-10 pb-14 sm:pt-16">
    <div class="reveal flex items-center gap-4">
      {/* The dot rides on the avatar rather than sitting beside the role, so
          the "still here, still writing" signal reads before any text does. */}
      <AuthorAvatar initial={initial} size="lg" />

      <Badge variant="secondary" className="h-6 gap-1.5 px-2.5 font-mono text-[0.6875rem]">
        <span class="relative flex size-1.5" aria-hidden="true">
          <span
            class="absolute inline-flex size-full animate-ping-slow rounded-full bg-primary opacity-60"
          ></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-primary"></span>
        </span>
        {AUTHOR_ROLE}
      </Badge>
    </div>

    <h1
      class="reveal text-gradient mt-6 text-[2.75rem] leading-[1.05] font-semibold tracking-tighter sm:text-6xl"
      style="--reveal-delay: 60ms"
    >
      {AUTHOR_NAME}
    </h1>

    <p
      class="reveal mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
      style="--reveal-delay: 120ms"
    >
      {SITE_LEAD}
    </p>

    <div class="reveal mt-8 flex flex-wrap items-center gap-2" style="--reveal-delay: 180ms">
      <a href="/blog" class={cn(buttonVariants({ size: 'lg' }), 'h-10 px-4')}>
        Read the writing
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform group-hover/button:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            rel="me"
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'lg' }),
              'h-10 px-3.5 text-muted-foreground'
            )}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="py-6">
    <h2 class="rule-heading label">Writing</h2>
    <div class="mt-4 space-y-3">
      {posts.map((post, i) => <PostCard entry={post} basePath="/blog" index={i} />)}
      {
        posts.length === 0 && (
          <p class="py-8 text-sm text-muted-foreground">Nothing published yet.</p>
        )
      }
    </div>
    {
      posts.length > 0 && (
        <a
          href="/blog"
          class={cn(
            buttonVariants({ variant: 'ghost', size: 'sm' }),
            'mt-4 -ml-2.5 font-mono text-muted-foreground'
          )}
        >
          All writing
          <span class="text-primary transition-transform group-hover/button:translate-x-0.5">
            →
          </span>
        </a>
      )
    }
  </section>

  {
    travel.length > 0 && (
      <section class="py-6">
        <h2 class="rule-heading label">Travel</h2>
        <div class="mt-4 space-y-3">
          {travel.map((post) => (
            <PostCard entry={post} basePath="/travel" />
          ))}
        </div>
        <a
          href="/travel"
          class={cn(
            buttonVariants({ variant: 'ghost', size: 'sm' }),
            'mt-4 -ml-2.5 font-mono text-muted-foreground'
          )}
        >
          All travel
          <span class="text-primary transition-transform group-hover/button:translate-x-0.5">→</span>
        </a>
      </section>
    )
  }

  {
    topics.length > 0 && (
      <section class="py-6 pb-16">
        <h2 class="rule-heading label">Topics</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {topics.map(({ tag, count }) => (
            <a
              href={`/tags/${tag}`}
              class={cn(
                badgeVariants({ variant: 'outline' }),
                'h-7 gap-2 px-2.5 font-mono text-xs font-normal text-muted-foreground transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary'
              )}
            >
              #{tag}
              <span class="tabular-nums opacity-60">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
