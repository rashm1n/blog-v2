---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostIndex from '../components/PostIndex.astro';
import { byYear, getPublished } from '../utils/posts';

const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const entries = [...posts, ...travel].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const years = byYear(entries);

// PostIndex already groups by year; the header carries the span, but only once
// there is one — a single year would just repeat the group label below it.
const span = years.length > 1 ? `${years[years.length - 1][0]}–${years[0][0]}` : undefined;

const description = 'Everything published here, newest first.';
---

<BaseLayout title="Archive" description={description}>
  <PageHeader
    eyebrow={span}
    title="Archive"
    description={description}
  />

  <div class="pb-8">
    <PostIndex entries={entries} />
    {entries.length === 0 && <p class="py-8 text-muted-foreground">Nothing published yet.</p>}
  </div>
</BaseLayout>
