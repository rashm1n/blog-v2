---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title="About" description={`About ${AUTHOR_NAME}.`}>
  <PageHeader eyebrow={AUTHOR_ROLE} title="About" />

  <div class="prose pb-8">
    <p>
      I'm {AUTHOR_NAME}, a software engineer. I write about ai, microservices, distributed systems, and whatever I'm debugging that week — and occasionally about places
      I've traveled to.
    </p>
    <p>
      This site is built with <a href="https://astro.build">Astro</a> and Tailwind, and deployed
      as a Docker container behind Caddy on a Hetzner VPS. No trackers you'd object to, no
      newsletter popup.
    </p>
  </div>

  <section class="py-6">
    <h2 class="rule-heading label">Elsewhere</h2>
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            rel="me"
            class="group inline-flex items-center gap-1.5 text-muted transition-colors hover:text-fg"
          >
            <span class="text-accent transition-transform group-hover:translate-x-0.5">→</span>
            {link.label}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
