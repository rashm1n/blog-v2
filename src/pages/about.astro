---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { AuthorAvatar } from '../components/AuthorAvatar';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import { cn } from '@/lib/utils';
import { AUTHOR_NAME, AUTHOR_ROLE, SOCIAL_LINKS } from '../consts';

const initial = AUTHOR_NAME.slice(0, 1).toUpperCase();
---

<BaseLayout title="About" description={`About ${AUTHOR_NAME}.`}>
  <PageHeader eyebrow={AUTHOR_ROLE} title="About" />

  <Card className="card-interactive mb-8 border bg-card/70 ring-0">
    <CardContent className="flex items-center gap-4">
      <AuthorAvatar initial={initial} size="md" />
      <div>
        <p class="text-sm font-medium text-foreground">{AUTHOR_NAME}</p>
        <p class="label mt-0.5">{AUTHOR_ROLE}</p>
      </div>
    </CardContent>
  </Card>

  <div class="prose pb-8">
    <p>
      I'm {AUTHOR_NAME}, a software engineer. I write about ai, microservices, distributed systems,
      and whatever I'm debugging that week — and occasionally about places I've traveled to.
    </p>
    <p>
      This site is built with <a href="https://astro.build">Astro</a> and Tailwind and hosted on my
      own VPS :).
    </p>
  </div>

  <section class="py-6 pb-16">
    <h2 class="rule-heading label">Elsewhere</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            rel="me"
            class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-10 px-3.5')}
          >
            {link.label}
            <span class="text-primary transition-transform group-hover/button:translate-x-0.5">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
