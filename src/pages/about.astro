---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title="About" description={`About ${AUTHOR_NAME}.`}>
  <PageHeader title="About" />

  <div class="prose pb-8">
    <p>
      I’m {AUTHOR_NAME}, a software engineer. I write about AI, microservices, distributed systems,
      and whatever I’m debugging that week, and occasionally about places I’ve traveled to.
    </p>
    <p>
      This site is built with <a href="https://astro.build">Astro</a> and Tailwind and hosted on my
      own VPS.
    </p>
  </div>

  <section class="pb-16">
    <h2 class="label">Elsewhere</h2>
    <p class="mt-2 flex flex-wrap gap-x-5">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            rel="me"
            class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-current"
          >
            {link.label}
          </a>
        ))
      }
    </p>
  </section>
</BaseLayout>
