---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPublished, allTags } from '../../utils/posts';

const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const entries = [...posts, ...travel];

const counts = new Map<string, number>();
for (const tag of allTags(entries)) {
  counts.set(tag, entries.filter((e) => e.data.tags.includes(tag)).length);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <PageHeader
    eyebrow={tags.length > 0 ? `${tags.length} ${tags.length === 1 ? 'tag' : 'tags'}` : undefined}
    title="Tags"
    description="Everything on the site, grouped by topic."
  />

  <ul class="grid grid-cols-2 gap-x-8 pb-8 sm:grid-cols-3">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}`} class="group flex items-baseline justify-between gap-3 border-b border-border py-2.5">
            <span class="display text-lg transition-colors group-hover:text-primary">{tag}</span>
            <span class="label tabular-nums">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {tags.length === 0 && <p class="pb-8 text-muted-foreground">No tags yet.</p>}
</BaseLayout>
