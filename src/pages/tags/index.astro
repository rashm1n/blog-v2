---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import { getPublished, allTags } from '../../utils/posts';

const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const entries = [...posts, ...travel];

const counts = new Map<string, number>();
for (const tag of allTags(entries)) {
  counts.set(tag, entries.filter((e) => e.data.tags.includes(tag)).length);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <PageHeader
    eyebrow={`${tags.length} ${tags.length === 1 ? 'tag' : 'tags'}`}
    title="Tags"
    description="Everything on the site, grouped by topic."
  />

  <div class="flex flex-wrap gap-2 pb-8">
    {
      tags.map(([tag, count]) => (
        <a
          href={`/tags/${tag}`}
          class={cn(
            badgeVariants({ variant: 'outline' }),
            'h-7 gap-2 px-2.5 font-mono text-xs font-normal text-muted-foreground transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary'
          )}
        >
          #{tag}
          <span class="tabular-nums opacity-60">{count}</span>
        </a>
      ))
    }
    {tags.length === 0 && <p class="text-sm text-muted-foreground">No tags yet.</p>}
  </div>
</BaseLayout>
