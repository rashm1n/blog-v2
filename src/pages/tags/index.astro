---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished, allTags } from '../../utils/posts';

const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
const tags = allTags([...posts, ...travel]);
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <div class="py-8">
    <h1 class="text-2xl font-semibold tracking-tight text-fg">Tags</h1>
    <div class="mt-6 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="rounded-full border border-border px-3 py-1 text-sm text-muted transition-colors hover:text-fg"
          >
            #{tag}
          </a>
        ))
      }
      {tags.length === 0 && <p class="text-sm text-muted">No tags yet.</p>}
    </div>
  </div>
</BaseLayout>
