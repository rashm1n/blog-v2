---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPublished, allTags } from '../../utils/posts';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
  const tags = allTags([...posts, ...travel]);

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      travel: travel.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  posts: CollectionEntry<'posts'>[];
  travel: CollectionEntry<'travel'>[];
}

const { tag } = Astro.params;
const { posts, travel } = Astro.props as Props;
const total = posts.length + travel.length;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <PageHeader
    title={tag}
    description={`${total} ${total === 1 ? 'entry' : 'entries'} tagged ${tag}.`}
  />

  <div class="pb-8">
    <PostIndex entries={[...posts, ...travel].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())} />
  </div>

  <a href="/tags" class="label mt-6 mb-8 inline-block text-primary underline underline-offset-4">
    All tags
  </a>
</BaseLayout>
