---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPublished, allTags } from '../../utils/posts';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
  const tags = allTags([...posts, ...travel]);

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      travel: travel.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  posts: CollectionEntry<'posts'>[];
  travel: CollectionEntry<'travel'>[];
}

const { tag } = Astro.params;
const { posts, travel } = Astro.props as Props;
const total = posts.length + travel.length;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <PageHeader
    eyebrow="Tagged"
    title={`#${tag}`}
    description={`${total} ${total === 1 ? 'entry' : 'entries'} tagged #${tag}.`}
  />

  <div class="pb-8">
    {posts.map((post) => <PostListItem entry={post} basePath="/blog" />)}
    {travel.map((post) => <PostListItem entry={post} basePath="/travel" />)}
  </div>

  <a
    href="/tags"
    class="group inline-flex items-center gap-1.5 pb-8 font-mono text-xs text-muted transition-colors hover:text-fg"
  >
    <span class="text-accent transition-transform group-hover:-translate-x-0.5">←</span>
    All tags
  </a>
</BaseLayout>
