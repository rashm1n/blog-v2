---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { getPublished, allTags } from '../../utils/posts';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const [posts, travel] = await Promise.all([getPublished('posts'), getPublished('travel')]);
  const tags = allTags([...posts, ...travel]);

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      travel: travel.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  posts: CollectionEntry<'posts'>[];
  travel: CollectionEntry<'travel'>[];
}

const { tag } = Astro.params;
const { posts, travel } = Astro.props as Props;
const total = posts.length + travel.length;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <PageHeader
    eyebrow="Tagged"
    title={`#${tag}`}
    description={`${total} ${total === 1 ? 'entry' : 'entries'} tagged #${tag}.`}
  />

  <div class="space-y-3 pb-8">
    {posts.map((post, i) => <PostCard entry={post} basePath="/blog" index={i} />)}
    {travel.map((post, i) => <PostCard entry={post} basePath="/travel" index={i} />)}
  </div>

  <a
    href="/tags"
    class={cn(
      buttonVariants({ variant: 'ghost', size: 'sm' }),
      'mb-8 -ml-2.5 font-mono text-muted-foreground'
    )}
  >
    <span class="text-primary transition-transform group-hover/button:-translate-x-0.5">←</span>
    All tags
  </a>
</BaseLayout>
