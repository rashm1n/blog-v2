---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('travel', ({ data }: { data: { draft: boolean } }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  const sorted = [...posts].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[i - 1]
        ? { title: sorted[i - 1].data.title, href: `/travel/${sorted[i - 1].id}` }
        : undefined,
      next: sorted[i + 1]
        ? { title: sorted[i + 1].data.title, href: `/travel/${sorted[i + 1].id}` }
        : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout entry={entry} headings={headings} body={entry.body ?? ''} prev={prev} next={next}>
  <Content />
</PostLayout>
