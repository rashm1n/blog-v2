---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPublished } from '../../utils/posts';

const posts = await getPublished('travel');
const description = 'Notes and photos from trips.';
---

<BaseLayout title="Travel" description={description}>
  <PageHeader
    eyebrow={`${posts.length} ${posts.length === 1 ? 'entry' : 'entries'}`}
    title="Travel"
    description={description}
  />

  <div class="pb-8">
    <PostIndex entries={posts} />
    {
      posts.length === 0 && (
        <p class="text-muted-foreground">
          No trips written up yet. <a href="/blog" class="text-primary underline underline-offset-4">Read the writing</a> in the meantime.
        </p>
      )
    }
  </div>
</BaseLayout>
