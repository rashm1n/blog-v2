---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../utils/posts';

const posts = await getPublished('travel');
const description = 'Notes and photos from trips.';
---

<BaseLayout title="Travel" description={description}>
  <PageHeader
    eyebrow={`${posts.length} ${posts.length === 1 ? 'entry' : 'entries'}`}
    title="Travel"
    description={description}
  />

  <div class="space-y-3 pb-8">
    {posts.map((post, i) => <PostCard entry={post} basePath="/travel" index={i} />)}
    {
      posts.length === 0 && (
        <p class="rounded-xl border border-dashed border-border bg-card/40 px-4 py-12 text-center text-sm text-muted-foreground backdrop-blur-sm">
          Nothing posted yet — coming soon.
        </p>
      )
    }
  </div>
</BaseLayout>
