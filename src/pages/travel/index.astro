---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPublished } from '../../utils/posts';
import { PHOTOS, photoMonth } from '../../data/photos';

const posts = await getPublished('travel');
const description = 'Notes and photos from trips.';

// The one landscape shot leads full width, so the portraits below fill whole rows.
// Each tile links to a large copy, so a photo can be seen whole without a lightbox script.
const photos = await Promise.all(
  PHOTOS.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: 2000, format: 'webp' })).src,
    landscape: photo.src.width > photo.src.height,
  })),
).then((all) => all.sort((a, b) => Number(b.landscape) - Number(a.landscape)));
---

<BaseLayout title="Travel" description={description} wide>
  <PageHeader
    eyebrow={posts.length > 0 ? `${posts.length} ${posts.length === 1 ? 'entry' : 'entries'}` : undefined}
    title="Travel"
    description={description}
  />

  {posts.length > 0 && (
    <div class="max-w-[51rem] pb-16">
      <PostIndex entries={posts} />
    </div>
  )}

  <section aria-labelledby="photos-heading">
    <h2 id="photos-heading" class="border-b border-border pb-4 text-[1.875rem] leading-tight">Photos</h2>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-8 pt-8 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
      {photos.map((photo) => (
        <li id={photo.id} class:list={[photo.landscape && 'col-span-full']}>
          <a href={photo.full} class="group block overflow-hidden rounded-lg bg-muted">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[480, 720, 960, 1440]}
              sizes={photo.landscape ? '(min-width: 64rem) 976px, 100vw' : '(min-width: 64rem) 300px, 50vw'}
              class:list={[
                'w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none',
                photo.landscape ? 'aspect-[16/9] lg:aspect-[21/9]' : 'aspect-[3/4]',
              ]}
            />
          </a>
          <p class="mt-3 text-base leading-snug">{photo.place}</p>
          <p class="label mt-1 tabular-nums">
            <time datetime={photo.taken.toISOString().slice(0, 10)}>{photoMonth(photo.taken)}</time>
            <span class="ml-3">{photo.coords}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
