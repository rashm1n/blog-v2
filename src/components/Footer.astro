---
import { SOCIAL_LINKS, AUTHOR_NAME } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
  <div class="flex flex-col gap-4 border-t border-border pt-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} {AUTHOR_NAME}</p>
    <nav class="flex gap-4">
      {
        SOCIAL_LINKS.map((link) => (
          <a href={link.url} class="transition-colors hover:text-fg" rel="me">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
