---
import { SOCIAL_LINKS, AUTHOR_NAME } from '../consts';

const year = new Date().getFullYear();
---

<footer data-noprint class="mx-auto mt-20 w-full max-w-2xl px-4 sm:px-6">
  <div
    class="flex flex-col gap-4 border-t border-border py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {AUTHOR_NAME}</p>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href="/archive" class="transition-colors hover:text-fg">Archive</a>
      <a href="/tags" class="transition-colors hover:text-fg">Tags</a>
      {
        SOCIAL_LINKS.map((link) => (
          <a href={link.url} class="transition-colors hover:text-fg" rel="me">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
