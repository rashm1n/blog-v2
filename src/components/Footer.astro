---
import { Separator } from '@/components/ui/separator';
import { SOCIAL_LINKS, AUTHOR_NAME } from '../consts';

const year = new Date().getFullYear();

const links = [
  { label: 'Archive', url: '/archive' },
  { label: 'Tags', url: '/tags' },
  ...SOCIAL_LINKS,
];
---

<footer data-noprint class="mx-auto mt-24 w-full max-w-5xl px-4 sm:px-6">
  <Separator />

  <div
    class="label flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {AUTHOR_NAME}</p>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {
        links.map((link) => (
          <a
            href={link.url}
            rel={link.url.startsWith('http') ? 'me' : undefined}
            class="underline decoration-transparent underline-offset-4 transition-colors hover:text-foreground hover:decoration-current"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
