---
import { SOCIAL_LINKS, AUTHOR_NAME } from '../consts';

const year = new Date().getFullYear();

const links = [
  { label: 'Archive', url: '/archive' },
  { label: 'Tags', url: '/tags' },
  { label: 'RSS', url: '/rss.xml' },
  { label: 'JSON Feed', url: '/feed.json' },
  { label: 'llms.txt', url: '/llms.txt' },
  ...SOCIAL_LINKS.filter((link) => link.url.startsWith('http')),
];
---

<footer data-noprint class="mx-auto mt-24 w-full max-w-5xl px-4 sm:px-6">
  <div class="flex flex-col gap-3 border-t border-border py-8 sm:flex-row sm:items-baseline sm:justify-between">
    <p class="label">&copy; {year} {AUTHOR_NAME}. Written by hand, served from a box I run.</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.url}
                rel={link.url.startsWith('http') ? 'me' : undefined}
                class="label underline decoration-transparent underline-offset-4 transition-colors hover:text-foreground hover:decoration-current"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
