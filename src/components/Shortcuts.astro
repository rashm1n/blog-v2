---
// Single-key shortcuts, vim-flavoured, plus the sheet that lists them (`?`).
// Ignored while typing and whenever a modifier is held, so they never fight
// the browser or a text field.
const keys = [
  { keys: ['/'], label: 'Search', also: '⌘K' },
  { keys: ['j', 'k'], label: 'Next or previous post in a list' },
  { keys: ['['], label: 'Previous article' },
  { keys: [']'], label: 'Next article' },
  { keys: ['t'], label: 'Switch light or dark theme' },
  { keys: ['?'], label: 'Show this list' },
];
---

<dialog id="shortcuts-dialog" data-noprint class="search-dialog" aria-labelledby="shortcuts-heading">
  <div class="w-full max-w-md overflow-hidden rounded-[var(--radius)] border border-border bg-card shadow-2xl shadow-black/20">
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <h2 id="shortcuts-heading" class="text-base">Keyboard shortcuts</h2>
      <button type="button" data-close class="label hover:text-foreground">
        Close <kbd class="kbd ml-1">esc</kbd>
      </button>
    </div>
    <dl class="divide-y divide-border px-4">
      {
        keys.map((row) => (
          <div class="flex items-center justify-between gap-4 py-2.5">
            <dt class="text-sm">{row.label}</dt>
            <dd class="flex shrink-0 gap-1">
              {row.keys.map((k) => <kbd class="kbd">{k}</kbd>)}
              {row.also && <kbd class="kbd" data-shortcut-hint>{row.also}</kbd>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('shortcuts-dialog') as HTMLDialogElement;

  dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  const typing = (el: EventTarget | null) =>
    el instanceof HTMLElement && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));

  // Moves focus through whatever list is on the page; skips rows a filter hid.
  const step = (dir: 1 | -1) => {
    const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')].filter(
      (el) => el.offsetParent !== null
    );
    if (!items.length) return;
    const index = items.indexOf(document.activeElement as HTMLElement);
    const next = items[index === -1 ? (dir === 1 ? 0 : items.length - 1) : Math.min(items.length - 1, Math.max(0, index + dir))];
    next.focus();
    next.scrollIntoView({ block: 'nearest' });
  };

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || typing(e.target)) return;
    // Another modal is up (search, lightbox); let it own the keyboard.
    if (document.querySelector('dialog[open]:not(#shortcuts-dialog)')) return;

    const actions: Record<string, () => void> = {
      '/': () => {
        dialog.close();
        document.getElementById('search-trigger')?.click();
      },
      '?': () => (dialog.open ? dialog.close() : dialog.showModal()),
      t: () => document.getElementById('theme-toggle')?.click(),
      j: () => step(1),
      k: () => step(-1),
      '[': () => document.querySelector<HTMLAnchorElement>('a[rel="prev"]')?.click(),
      ']': () => document.querySelector<HTMLAnchorElement>('a[rel="next"]')?.click(),
    };

    const action = actions[e.key];
    if (!action) return;
    e.preventDefault();
    action();
  });
</script>
