---
// Icon state is driven entirely by the .dark class on <html>, so it renders
// correctly on the very first paint — no flash, no JS needed to sync it.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="relative grid h-8 w-8 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg"
>
  <svg
    class="icon icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="icon icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .icon {
    grid-area: 1 / 1;
    height: 1rem;
    width: 1rem;
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .icon-moon,
  :global(:root.dark) .icon-sun {
    opacity: 0;
    transform: rotate(-70deg) scale(0.6);
  }

  .icon-sun,
  :global(:root.dark) .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<!-- Bundled rather than is:inline so Astro can hash it for the CSP. The
     anti-flash script in BaseHead is the one that genuinely has to be inline;
     this only runs on click. -->
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.toggle('dark');
    const dark = root.classList.contains('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    window.dispatchEvent(new CustomEvent('theme-change', { detail: { dark } }));
  });
</script>
