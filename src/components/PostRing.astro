---
import { ringMarkup } from '../utils/ring';
import { titleTransitionName } from '../utils/posts';

interface Props {
  id: string;
  tags: string[];
  class?: string;
}

const { id, tags, class: className } = Astro.props;
const markup = ringMarkup(id, tags, {
  ring: 'color-mix(in oklab, var(--muted-foreground) 45%, transparent)',
  chord: 'var(--muted-foreground)',
  node: 'var(--foreground)',
  post: 'var(--primary)',
});
// Same name in PostIndex and PostLayout, so the ring grows into the header
// alongside the title morph.
const transition = `view-transition-name: ${titleTransitionName(id)}-ring; view-transition-class: post-title`;
---

<svg viewBox="0 0 100 100" aria-hidden="true" class:list={['post-ring', className]} style={transition} set:html={markup} />
