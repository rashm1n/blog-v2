---
import { formatDateISO, readingTime, sectionFor, type AnyEntry } from '../utils/posts';

interface Props {
  entries: AnyEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section data-noprint class="mt-16">
      <h2 class="rule-heading label">Read next</h2>
      <ul class="mt-3">
        {entries.map((entry) => (
          <li>
            <a
              href={`${sectionFor(entry.collection).path}/${entry.id}`}
              class="group -mx-3 flex items-baseline justify-between gap-4 rounded-lg px-3 py-3 transition-colors hover:bg-accent"
            >
              <span class="flex items-baseline gap-2.5 text-sm leading-snug text-foreground transition-colors group-hover:text-primary">
                {/* Slides out from under the title on hover — a hint of
                    direction without adding a permanent glyph column. */}
                <span
                  class="w-0 shrink-0 overflow-hidden text-primary opacity-0 transition-all group-hover:w-2.5 group-hover:opacity-100"
                  aria-hidden="true"
                >
                  →
                </span>
                {entry.data.title}
              </span>
              <span class="hidden shrink-0 font-mono text-xs tabular-nums text-muted-foreground xs:block">
                {formatDateISO(entry.data.pubDate)} · {readingTime(entry.body ?? '')} min
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
