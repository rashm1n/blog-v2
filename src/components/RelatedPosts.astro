---
import { formatDateISO, readingTime, sectionFor, type AnyEntry } from '../utils/posts';

interface Props {
  entries: AnyEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="mt-16">
      <h2 class="rule-heading label">Read next</h2>
      <ul class="mt-3">
        {entries.map((entry) => (
          <li>
            <a
              href={`${sectionFor(entry.collection).path}/${entry.id}`}
              class="group -mx-3 flex items-baseline justify-between gap-4 rounded-lg px-3 py-3 transition-colors hover:bg-surface"
            >
              <span class="text-sm leading-snug text-fg transition-colors group-hover:text-accent">
                {entry.data.title}
              </span>
              <span class="hidden shrink-0 font-mono text-xs tabular-nums text-muted xs:block">
                {formatDateISO(entry.data.pubDate)} · {readingTime(entry.body ?? '')} min
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
