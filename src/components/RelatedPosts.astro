---
import { formatDate, sectionFor, type AnyEntry } from '../utils/posts';

interface Props {
  entries: AnyEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section data-noprint class="mt-16">
      <h2 class="rule-heading label">Read next</h2>
      <ul class="mt-3">
        {entries.map((entry) => (
          <li>
            <a
              href={`${sectionFor(entry.collection).path}/${entry.id}`}
              class="group flex items-baseline justify-between gap-6 py-2.5"
            >
              <span class="font-serif text-lg leading-snug text-foreground transition-colors group-hover:text-primary">
                {entry.data.title}
              </span>
              <span class="label hidden shrink-0 tabular-nums xs:block">
                {formatDate(entry.data.pubDate)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
