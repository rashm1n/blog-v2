---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
---

<header
  id="site-header"
  data-noprint
  class="sticky top-0 z-40 border-b border-transparent bg-background/70 backdrop-blur-xl transition-colors duration-200 data-[scrolled]:border-border data-[scrolled]:bg-background/85"
>
  <div class="mx-auto flex h-16 max-w-2xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="group font-mono text-sm font-medium tracking-tight text-foreground transition-opacity hover:opacity-80"
    >
      <span class="text-primary">~</span><span class="text-muted-foreground">/</span>{SITE_TITLE}
    </a>

    <nav class="flex items-center gap-0.5 text-sm">
      {
        NAV_LINKS.map((link) => {
          const active = pathname === link.href || pathname.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                buttonVariants({ variant: 'ghost', size: 'sm' }),
                'px-2.5 font-normal',
                active ? 'bg-muted text-foreground' : 'text-muted-foreground',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      <span class="mx-1.5 hidden h-4 w-px bg-border xs:block"></span>

      {/* The classic shadcn command-menu trigger: an outline button carrying
          its own shortcut hint, rather than a bare icon. */}
      <button
        id="search-trigger"
        type="button"
        aria-label="Search"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'gap-1.5 pr-1.5 text-muted-foreground'
        )}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <kbd class="kbd hidden xs:inline-flex" data-shortcut-hint>⌘K</kbd>
      </button>

      <ThemeToggle />
    </nav>
  </div>
</header>

<!-- Bundled rather than is:inline so Astro can hash it for the CSP. -->
<script>
  const header = document.getElementById('site-header');
  if (header) {
    const sync = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Windows/Linux users press Ctrl, not Cmd — show them the key they actually have.
  if (!/Mac|iPhone|iPad/.test(navigator.platform ?? navigator.userAgent)) {
    for (const hint of document.querySelectorAll('[data-shortcut-hint]')) {
      hint.textContent = 'Ctrl K';
    }
  }
</script>
