---
import { cn } from '@/lib/utils';
import { NAV_LINKS, SITE_URL } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const wordmark = new URL(SITE_URL).host;
---

<header
  id="site-header"
  data-noprint
  class="sticky top-0 z-40 border-b border-transparent bg-background/80 backdrop-blur-xl transition-colors duration-200 data-[scrolled]:border-border"
>
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-2 px-4 sm:gap-6 sm:px-6">
    <a
      href="/"
      class="display text-[1.0625rem] tracking-[-0.01em] text-foreground transition-colors hover:text-primary"
    >
      {/* The TLD goes on the narrowest phones so the whole bar fits 360px. */}
      {wordmark.replace(/\.dev$/, '')}<span class="hidden xs:inline">.dev</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-0.5">
      {
        NAV_LINKS.map((link) => {
          const active = pathname === link.href || pathname.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class={cn(
                'label rounded-[var(--radius)] px-1.5 py-1 text-[0.8125rem] transition-colors hover:text-foreground xs:px-2',
                active && 'bg-accent text-foreground'
              )}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      {/* Shaped like the field it opens, so it reads as "search" without a
          label, and carries the shortcut that skips it. */}
      <button
        id="search-trigger"
        type="button"
        aria-label="Search"
        aria-keyshortcuts="/ Meta+K Control+K"
        class="label flex h-8 items-center gap-2 rounded-[var(--radius)] border border-border bg-card px-2 transition-colors hover:border-primary hover:text-foreground sm:w-56"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5 shrink-0"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">Search posts</span>
        <kbd class="kbd ml-auto hidden sm:inline-flex">/</kbd>
      </button>

      <ThemeToggle />
    </div>
  </div>
</header>

<!-- Bundled rather than is:inline so Astro can hash it for the CSP. -->
<script>
  const header = document.getElementById('site-header');
  if (header) {
    const sync = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Windows/Linux users press Ctrl, not Cmd — show them the key they actually have.
  if (!/Mac|iPhone|iPad/.test(navigator.platform ?? navigator.userAgent)) {
    for (const hint of document.querySelectorAll('[data-shortcut-hint]')) {
      hint.textContent = 'Ctrl K';
    }
  }
</script>
