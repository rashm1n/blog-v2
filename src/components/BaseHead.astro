---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { AUTHOR_NAME, SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';
import { jsonLdScript, siteNodes, type JsonLdNode } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  /** Page-specific schema.org nodes, appended to the site-wide Person + WebSite. */
  jsonLd?: JsonLdNode[];
  /** Path to a raw-Markdown twin of this page, advertised to LLM crawlers. */
  markdownPath?: string;
  /** Set alongside `article` — becomes the `article:*` Open Graph properties. */
  published?: Date;
  updated?: Date;
  tags?: string[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  article = false,
  jsonLd = [],
  markdownPath,
  published,
  updated,
  tags = [],
} = Astro.props;

const siteURL = Astro.site ?? new URL(SITE_URL);
const pageTitle = title ? `${title} — ${SITE_TITLE}` : `${SITE_TITLE} — software engineer`;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(image ?? '/og-default.png', siteURL);

// Every card src/utils/og.ts renders is exactly this size. Declaring it lets a
// crawler reserve the space before the bytes arrive, which is the difference
// between a preview that appears whole and one that pops in.
const OG_IMAGE = { width: '1200', height: '630', type: 'image/png' } as const;
const ogImageAlt = `${title ?? SITE_TITLE} — ${SITE_URL.replace(/^https?:\/\//, '')}`;
const markdownURL = markdownPath ? new URL(markdownPath, siteURL) : undefined;
const graph = [...siteNodes(siteURL), ...jsonLd];

// Self-hosted Umami; default script path is on some blocklists, so this is
// expected to be reverse-proxied to your own domain (e.g. /stats.js) — see Phase 5 Caddyfile.
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
const umamiScriptUrl = import.meta.env.UMAMI_SCRIPT_URL ?? '/stats.js';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
<link rel="alternate" type="application/feed+json" title={SITE_TITLE} href="/feed.json" />
{
  markdownURL && (
    <link rel="alternate" type="text/markdown" href={markdownURL} title="Markdown source" />
  )
}
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:type" content={OG_IMAGE.type} />
<meta property="og:image:width" content={OG_IMAGE.width} />
<meta property="og:image:height" content={OG_IMAGE.height} />
<meta property="og:image:alt" content={ogImageAlt} />

{
  article && (
    <>
      {published && <meta property="article:published_time" content={published.toISOString()} />}
      {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
      <meta property="article:author" content={AUTHOR_NAME} />
      {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script type="application/ld+json" is:inline set:html={jsonLdScript(graph)}></script>

<Font cssVariable="--font-face-sans" preload />
<Font cssVariable="--font-face-mono" preload />

{import.meta.env.PROD && umamiWebsiteId && (
  <script is:inline defer src={umamiScriptUrl} data-website-id={umamiWebsiteId}></script>
)}

<script is:inline>
  const stored = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  if (stored === 'dark' || (!stored && prefersDark)) {
    document.documentElement.classList.add('dark');
  }
</script>
