---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { formatDate, formatDateISO, readingTime, titleTransitionName } from '../utils/posts';

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'travel'>;
  basePath: '/blog' | '/travel';
  /** Leads with the post's hero image, for the newest post on the homepage. */
  feature?: boolean;
}

const { entry, basePath, feature = false } = Astro.props;
const { title, description, pubDate, tags, heroImage } = entry.data;
const { body = '' } = entry;
const minutes = readingTime(body);
---

<a href={`${basePath}/${entry.id}`} class="group block">
  {/* `border ring-0` rather than shadcn's default ring: `.card-interactive`
      animates border-color on hover, and a utility class for the colour would
      sit in a later cascade layer and win. Leaving the colour to the base
      `* { border-color }` rule lets the component layer drive it. */}
  <Card className="card-interactive gap-3 border py-5 ring-0">
    {
      feature && heroImage && (
        // First child of the card, so shadcn's Card drops its top padding and
        // rounds the image's top corners to match.
        <Image
          src={heroImage}
          alt=""
          width={1200}
          height={600}
          loading="eager"
          class="mb-2 aspect-[2/1] w-full border-b object-cover"
        />
      )
    }

    <CardHeader className="gap-2">
      <div class="label flex items-center gap-2">
        <time datetime={pubDate.toISOString()} title={formatDate(pubDate)} class="tabular-nums">
          {formatDateISO(pubDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min</span>
      </div>

      <CardTitle
        className="text-base leading-snug font-medium transition-colors group-hover:text-primary sm:text-lg"
      >
        <span
          style={`view-transition-name: ${titleTransitionName(entry.id)}; view-transition-class: post-title`}
        >
          {title}
        </span>
      </CardTitle>
    </CardHeader>

    <CardContent className="space-y-3">
      <p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">{description}</p>

      {
        tags.length > 0 && (
          // Plain text, not links: the whole card is already an <a>, and an
          // anchor inside an anchor is invalid HTML. /tags has the clickable
          // version.
          <p class="label flex flex-wrap gap-x-3">
            {tags.slice(0, 3).map((tag: string) => (
              <span>#{tag}</span>
            ))}
          </p>
        )
      }
    </CardContent>
  </Card>
</a>
