---
import { Image } from 'astro:assets';
import { byYear, formatDate, readingTime, sectionFor, titleTransitionName, type AnyEntry } from '../utils/posts';

interface Props {
  entries: AnyEntry[];
}

const { entries } = Astro.props;
const years = byYear(entries);
const newest = entries[0];

// Only label the section when the list mixes writing and travel (archive, tags);
// on /blog every row would say the same thing.
const mixed = new Set(entries.map((e) => e.collection)).size > 1;

const shortDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

{/* `git log --graph`, for posts. Rows carry their tags in data-tags so
    TopicFilter can hide them without a round trip. */}
<ol class="log" data-log>
  {
    years.map(([year, group]) => (
      <>
        <li class="log__year label tabular-nums" data-log-year={year}>
          {year}
        </li>
        {group.map((entry) => (
          <li
            class="log__entry"
            data-tags={entry.data.tags.join(' ')}
            data-year={year}
            data-latest={entry === newest ? '' : undefined}
          >
            <a
              href={`${sectionFor(entry.collection).path}/${entry.id}`}
              class="log__link"
              data-nav-item
            >
              <span class="log__date label tabular-nums">
                <time datetime={entry.data.pubDate.toISOString()} title={formatDate(entry.data.pubDate)}>
                  {shortDate(entry.data.pubDate)}
                </time>
              </span>

              <span>
                <span
                  class="log__title block"
                  style={`view-transition-name: ${titleTransitionName(entry.id)}; view-transition-class: post-title`}
                >
                  {entry.data.title}
                </span>
                {entry.data.description && (
                  <span class="log__description block">{entry.data.description}</span>
                )}
                <span class="log__refs">
                  {entry === newest && <span class="ref ref--latest">latest</span>}
                  {mixed && entry.collection === 'travel' && <span class="ref">travel</span>}
                  {entry.data.tags.map((tag: string) => (
                    <span class="ref">{tag}</span>
                  ))}
                  <span class="label ml-1">{readingTime(entry.body ?? '')} min read</span>
                </span>
              </span>

              {entry.data.heroImage ? (
                <Image src={entry.data.heroImage} alt="" width={320} class="log__thumb" loading="lazy" />
              ) : (
                <span />
              )}
            </a>
          </li>
        ))}
      </>
    ))
  }
</ol>
