---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="pt-10 pb-8 sm:pt-16">
  {eyebrow && <p class="reveal label">{eyebrow}</p>}
  <h1
    class="reveal text-gradient mt-3 text-3xl font-semibold tracking-tighter sm:text-[2.75rem]"
    style="--reveal-delay: 60ms"
  >
    {title}
  </h1>
  {
    description && (
      <p
        class="reveal mt-3 max-w-xl text-base leading-relaxed text-muted-foreground"
        style="--reveal-delay: 120ms"
      >
        {description}
      </p>
    )
  }
</header>
