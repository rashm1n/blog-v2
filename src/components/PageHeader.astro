---
interface Props {
  /** A count or span, shown under the description as supporting detail. */
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="pt-12 pb-10 sm:pt-20">
  <h1 class="text-[2.5rem] leading-[1.02] sm:text-[3.5rem]">{title}</h1>
  {description && <p class="mt-4 max-w-xl text-muted-foreground">{description}</p>}
  {eyebrow && <p class="label mt-2 tabular-nums">{eyebrow}</p>}
</header>
