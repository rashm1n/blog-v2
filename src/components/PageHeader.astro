---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="reveal pt-10 pb-8 sm:pt-16">
  {eyebrow && <p class="label">{eyebrow}</p>}
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h1>
  {description && <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">{description}</p>}
</header>
