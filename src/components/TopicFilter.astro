---
import type { AnyEntry } from '../utils/posts';

interface Props {
  entries: AnyEntry[];
}

const { entries } = Astro.props;

// Most-used first, so the row reads as "what this site is about".
const counts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const topics = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

{/* Without JS these buttons would do nothing, so they ship hidden and the
    script reveals them. /tags is the no-JS route to the same thing. */}
{
  topics.length > 1 && (
    <div data-topic-filter hidden class="mb-2 flex flex-wrap items-center gap-2" role="group" aria-label="Filter by topic">
      <button type="button" class="chip" data-topic="" aria-pressed="true">
        all <span class="chip__count tabular-nums">{entries.length}</span>
      </button>
      {topics.map(([tag, count]) => (
        <button type="button" class="chip" data-topic={tag} aria-pressed="false">
          {tag} <span class="chip__count tabular-nums">{count}</span>
        </button>
      ))}
      <p data-topic-status role="status" aria-live="polite" class="sr-only" />
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-topic-filter]');
  const log = document.querySelector<HTMLElement>('[data-log]');

  if (root && log) {
    root.hidden = false;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const rows = [...log.querySelectorAll<HTMLElement>('.log__entry')];
    const years = [...log.querySelectorAll<HTMLElement>('[data-log-year]')];
    const status = root.querySelector<HTMLElement>('[data-topic-status]')!;

    const apply = (topic: string, push: boolean) => {
      let shown = 0;
      for (const row of rows) {
        const match = !topic || (row.dataset.tags ?? '').split(' ').includes(topic);
        row.hidden = !match;
        if (match) shown++;
      }
      // A year with nothing left under it would be a heading for an empty list.
      for (const year of years) {
        year.hidden = !rows.some((r) => !r.hidden && r.dataset.year === year.dataset.logYear);
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.topic === topic));
      }
      status.textContent = topic ? `${shown} ${shown === 1 ? 'post' : 'posts'} tagged ${topic}` : '';

      if (push) {
        const url = new URL(location.href);
        if (topic) url.searchParams.set('topic', topic);
        else url.searchParams.delete('topic');
        history.replaceState(null, '', url);
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const topic = button.dataset.topic ?? '';
        // Pressing the active topic again clears it, like any toggle.
        const active = button.getAttribute('aria-pressed') === 'true';
        apply(active ? '' : topic, true);
      });
    }

    const initial = new URL(location.href).searchParams.get('topic') ?? '';
    if (buttons.some((b) => b.dataset.topic === initial)) apply(initial, false);
  }
</script>
