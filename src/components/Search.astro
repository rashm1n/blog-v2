---
// Command-palette style search over the Pagefind index built in `postbuild`.
---

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/20 px-4 pt-[12vh] backdrop-blur-sm dark:bg-black/60"
>
  <div
    id="search-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
    class="w-full max-w-xl overflow-hidden rounded-xl border border-border bg-bg shadow-2xl shadow-black/10 dark:shadow-black/50"
  >
    <div class="flex items-center gap-3 border-b border-border px-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 shrink-0 text-muted"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search posts…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        class="w-full bg-transparent py-3.5 text-[0.9375rem] text-fg outline-none placeholder:text-muted"
      />
      <kbd class="kbd">esc</kbd>
    </div>

    <div id="search-results" class="max-h-[52vh] overflow-y-auto p-2"></div>

    <div
      class="flex items-center gap-4 border-t border-border bg-surface px-4 py-2.5 font-mono text-[0.6875rem] text-muted"
    >
      <span class="flex items-center gap-1.5"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd>
        navigate</span>
      <span class="flex items-center gap-1.5"><kbd class="kbd">↵</kbd> open</span>
    </div>
  </div>
</div>

<script is:inline>
  // is:inline on purpose — see the note in the module script below.
  window.loadPagefind = () => {
    window.__pagefind ??= import('/pagefind/pagefind.js')
      .then(async (module) => {
        await module.init?.();
        return module;
      })
      .catch((error) => {
        // Drop the cached rejection so a transient failure can be retried.
        window.__pagefind = undefined;
        throw error;
      });
    return window.__pagefind;
  };
</script>

<script>
  interface PagefindResult {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }

  interface Pagefind {
    search: (
      query: string
    ) => Promise<{ results: { id: string; data: () => Promise<PagefindResult> }[] }>;
  }

  declare global {
    interface Window {
      loadPagefind: () => Promise<Pagefind>;
    }
  }

  let pagefind: Pagefind | null = null;

  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  let lastFocused: HTMLElement | null = null;
  let selected = 0;

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );

  const message = (text: string) => {
    results.innerHTML = `<p class="px-3 py-8 text-center text-sm text-muted">${text}</p>`;
  };

  async function ensurePagefind() {
    if (pagefind) return pagefind;
    try {
      // Loaded via the is:inline script above rather than importing here directly:
      // Vite constant-folds a dynamic import's specifier even behind a variable or
      // @vite-ignore, rewrites the call through its preload helper, and — because
      // /pagefind/pagefind.js doesn't exist until the `pagefind` postbuild step has
      // run — leaves an unresolved `__VITE_PRELOAD__` identifier that throws a
      // ReferenceError on the first search. Inline scripts are passed through untouched.
      pagefind = await window.loadPagefind();
    } catch {
      message('Search is only available in the built site.');
    }
    return pagefind;
  }

  function open() {
    lastFocused = document.activeElement as HTMLElement;
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
    input.value = '';
    message('Type to search.');
    input.focus();
    ensurePagefind();
  }

  function close() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  const isOpen = () => !overlay.classList.contains('hidden');

  function items() {
    return [...results.querySelectorAll<HTMLAnchorElement>('[data-result]')];
  }

  function highlight(next: number) {
    const list = items();
    if (!list.length) return;
    selected = (next + list.length) % list.length;
    list.forEach((el, i) => {
      el.toggleAttribute('data-selected', i === selected);
      if (i === selected) el.scrollIntoView({ block: 'nearest' });
    });
  }

  document.getElementById('search-trigger')?.addEventListener('click', open);

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
      return;
    }
    if (!isOpen()) return;

    if (e.key === 'Escape') {
      close();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(selected + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(selected - 1);
    } else if (e.key === 'Enter') {
      const target = items()[selected];
      if (target) {
        e.preventDefault();
        window.location.href = target.href;
      }
    }
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        message('Type to search.');
        return;
      }
      const pf = await ensurePagefind();
      if (!pf) return;

      const search = await pf.search(query);
      const entries = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));

      if (entries.length === 0) {
        message(`No results for “${escapeHtml(query)}”.`);
        return;
      }

      results.innerHTML = entries
        .map(
          (entry) => `
            <a href="${entry.url}" data-result class="search-result">
              <p class="text-sm font-medium text-fg">${escapeHtml(entry.meta.title ?? entry.url)}</p>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted">${entry.excerpt}</p>
              <p class="mt-1.5 font-mono text-[0.6875rem] text-muted/80">${escapeHtml(entry.url.replace(/\/$/, '') || '/')}</p>
            </a>`
        )
        .join('');
      selected = -1;
      highlight(0);
    }, 120);
  });
</script>
