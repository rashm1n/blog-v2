---
// Command-palette style search over the Pagefind index built in `postbuild`.
//
// A native <dialog> rather than a hand-rolled overlay: `showModal()` supplies
// the focus trap, Esc handling, background inertness and top-layer stacking
// that an `aria-modal` div only claims to have.
---

<dialog id="search-dialog" data-noprint class="search-dialog" aria-label="Search">
  <div
    id="search-panel"
    class="w-full max-w-xl overflow-hidden rounded-xl border border-border bg-bg shadow-2xl shadow-black/10 dark:shadow-black/50"
  >
    <div class="flex items-center gap-3 border-b border-border px-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 shrink-0 text-muted"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search posts…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        class="w-full bg-transparent py-3.5 text-[0.9375rem] text-fg outline-none placeholder:text-muted"
      />
      <kbd class="kbd">esc</kbd>
    </div>

    <div
      id="search-results"
      role="listbox"
      aria-label="Search results"
      class="max-h-[52vh] overflow-y-auto p-2"
    >
    </div>

    <!-- Counts are announced from here rather than from the list itself, so a
         screen reader says "8 results" instead of re-reading every excerpt on
         each keystroke. -->
    <p id="search-status" role="status" aria-live="polite" class="sr-only"></p>

    <div
      class="flex items-center gap-4 border-t border-border bg-surface px-4 py-2.5 font-mono text-[0.6875rem] text-muted"
    >
      <span class="flex items-center gap-1.5"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd>
        navigate</span>
      <span class="flex items-center gap-1.5"><kbd class="kbd">↵</kbd> open</span>
    </div>
  </div>
</dialog>

<!-- Served straight from public/ rather than bundled — see the file for why
     Vite must not touch it. `is:inline` here means "don't process this tag";
     it carries no inline code, so `script-src 'self'` covers it without a hash. -->
<script is:inline src="/pagefind-loader.js"></script>

<script>
  interface PagefindResult {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }

  interface Pagefind {
    search: (
      query: string
    ) => Promise<{ results: { id: string; data: () => Promise<PagefindResult> }[] }>;
  }

  declare global {
    interface Window {
      loadPagefind: () => Promise<Pagefind>;
    }
  }

  let pagefind: Pagefind | null = null;

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;
  const status = document.getElementById('search-status')!;

  let selected = 0;

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );

  // Built as a node with textContent rather than an HTML string: one caller
  // passes the user's own query back, and this way no caller has to remember
  // to escape it.
  const message = (text: string, announce = '') => {
    const paragraph = document.createElement('p');
    paragraph.className = 'px-3 py-8 text-center text-sm text-muted';
    paragraph.textContent = text;
    results.replaceChildren(paragraph);
    status.textContent = announce;
    input.setAttribute('aria-expanded', 'false');
  };

  async function ensurePagefind() {
    if (pagefind) return pagefind;
    try {
      // Loaded via the is:inline script above rather than importing here directly:
      // Vite constant-folds a dynamic import's specifier even behind a variable or
      // @vite-ignore, rewrites the call through its preload helper, and — because
      // /pagefind/pagefind.js doesn't exist until the `pagefind` postbuild step has
      // run — leaves an unresolved `__VITE_PRELOAD__` identifier that throws a
      // ReferenceError on the first search. Inline scripts are passed through untouched.
      pagefind = await window.loadPagefind();
    } catch {
      message('Search is only available in the built site.');
    }
    return pagefind;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    // The results list is the only thing that should scroll while this is up.
    document.body.style.overflow = 'hidden';
    input.value = '';
    message('Type to search.');
    input.focus();
    ensurePagefind();
  }

  function close() {
    if (dialog.open) dialog.close();
  }

  // Fires for `close()`, Esc and the backdrop path alike, so the scroll lock is
  // released in exactly one place. Focus returns to the trigger natively.
  dialog.addEventListener('close', () => {
    document.body.style.overflow = '';
  });

  function items() {
    return [...results.querySelectorAll<HTMLAnchorElement>('[data-result]')];
  }

  function highlight(next: number) {
    const list = items();
    if (!list.length) return;
    selected = (next + list.length) % list.length;
    list.forEach((el, i) => {
      el.toggleAttribute('data-selected', i === selected);
      el.setAttribute('aria-selected', String(i === selected));
      if (i === selected) el.scrollIntoView({ block: 'nearest' });
    });
  }

  document.getElementById('search-trigger')?.addEventListener('click', open);

  // A click lands on the dialog itself only when it misses the panel inside it.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
      return;
    }
    if (!dialog.open) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(selected + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(selected - 1);
    } else if (e.key === 'Enter') {
      const target = items()[selected];
      if (target) {
        e.preventDefault();
        window.location.href = target.href;
      }
    }
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        message('Type to search.');
        return;
      }
      const pf = await ensurePagefind();
      if (!pf) return;

      const search = await pf.search(query);
      const entries = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));

      if (entries.length === 0) {
        message(`No results for “${query}”.`, 'No results');
        return;
      }

      results.innerHTML = entries
        .map(
          // `excerpt` is the only field interpolated raw: Pagefind escapes the
          // page text it indexed and adds just its own <mark> tags. Everything
          // else goes through escapeHtml, including the URL in the href.
          (entry) => `
            <a href="${escapeHtml(entry.url)}" data-result role="option" aria-selected="false" class="search-result">
              <p class="text-sm font-medium text-fg">${escapeHtml(entry.meta.title ?? entry.url)}</p>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted">${entry.excerpt}</p>
              <p class="mt-1.5 font-mono text-[0.6875rem] text-muted/80">${escapeHtml(entry.url.replace(/\/$/, '') || '/')}</p>
            </a>`
        )
        .join('');
      input.setAttribute('aria-expanded', 'true');
      status.textContent = `${entries.length} result${entries.length === 1 ? '' : 's'}`;
      selected = -1;
      highlight(0);
    }, 120);
  });
</script>
