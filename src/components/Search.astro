<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 px-4 pt-[15vh]"
>
  <div
    id="search-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
    class="w-full max-w-lg rounded-xl border border-border bg-bg p-4 shadow-2xl"
  >
    <input
      id="search-input"
      type="text"
      placeholder="Search posts…"
      autocomplete="off"
      class="w-full border-b border-border bg-transparent pb-3 text-fg outline-none placeholder:text-muted"
    />
    <div id="search-results" class="mt-3 max-h-[50vh] overflow-y-auto"></div>
  </div>
</div>

<script>
  let pagefind: {
    init?: () => Promise<void>;
    search: (
      query: string
    ) => Promise<{ results: { id: string; data: () => Promise<PagefindResult> }[] }>;
  } | null = null;

  interface PagefindResult {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }

  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  async function ensurePagefind() {
    if (pagefind) return pagefind;
    try {
      // @ts-expect-error — generated by the pagefind postbuild step, not present at typecheck time
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pagefind?.init?.();
    } catch {
      results.innerHTML =
        '<p class="py-6 text-sm text-muted">Search is only available in the built site.</p>';
    }
    return pagefind;
  }

  function open() {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    input.value = '';
    results.innerHTML = '';
    input.focus();
    ensurePagefind();
  }

  function close() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
  }

  document.getElementById('search-trigger')?.addEventListener('click', open);

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      overlay.classList.contains('hidden') ? open() : close();
    }
    if (e.key === 'Escape') close();
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        results.innerHTML = '';
        return;
      }
      const pf = await ensurePagefind();
      if (!pf) return;
      const search = await pf.search(query);
      const entries = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      results.innerHTML = entries
        .map(
          (entry) => `
            <a href="${entry.url}" class="block rounded-lg px-2 py-3 hover:bg-border/60">
              <p class="text-sm font-medium text-fg">${entry.meta.title ?? entry.url}</p>
              <p class="mt-1 line-clamp-2 text-xs text-muted">${entry.excerpt}</p>
            </a>`
        )
        .join('');
      if (entries.length === 0) {
        results.innerHTML = '<p class="py-6 text-sm text-muted">No results.</p>';
      }
    }, 120);
  });
</script>
