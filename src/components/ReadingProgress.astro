---
// Thin accent rule across the top of the viewport tracking progress through the
// article body (not the whole document — the footer shouldn't count as reading).
---

<div
  id="reading-progress"
  data-noprint
  aria-hidden="true"
  class="fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-primary will-change-transform"
>
</div>

<script>
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('article');

  if (bar && article) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const start = article.offsetTop;
      const distance = article.offsetHeight - window.innerHeight;
      if (distance <= 0) {
        bar.style.transform = 'scaleX(0)';
        return;
      }
      const progress = (window.scrollY - start) / distance;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
